# Vorlage fuer deine persoenlichen Garmin-Zugangsdaten.
# 1. Diese Datei kopieren:  cp .env.example .env
# 2. In .env die Werte eintragen.
# .env wird von git ignoriert und nie hochgeladen.

# Garmin Connect Login (z.B. fuer die Python-Bibliothek garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Persoenlicher API-Key / Token
GARMIN_API_KEY=

# Nur fuer das offizielle Garmin Developer Program (Health/Activity API)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
